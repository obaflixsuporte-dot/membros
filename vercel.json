{
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/login.js": {
      "includeFiles": "content/cursos.json"
    },
    "api/conteudo.js": {
      "includeFiles": "content/**/*.{json,md}"
    },
    "api/media.js": {
      "includeFiles": "content/{cursos.json,*/media/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
